# Maintainer: funstorm15 <funstorm15@users.noreply.github.com>
# AUR package "survive85-bin": the prebuilt static release binary.
pkgname=survive85-bin
_pkgname=survive85
pkgver=0.1.0
pkgrel=1
pkgdesc="Turn-based terminal roguelike: live from 18 to 85 on real hazard ratios (RU/EN) — prebuilt"
arch=('x86_64' 'aarch64' 'armv7h')
url="https://github.com/funstorm15/survive85"
license=('MIT' 'CC-BY-4.0')
provides=("$_pkgname")
conflicts=("$_pkgname")
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_linux_arm64.tar.gz")
source_armv7h=("$_pkgname-$pkgver-armv7h.tar.gz::$url/releases/download/v$pkgver/${_pkgname}_${pkgver}_linux_armv7.tar.gz")
# Filled from checksums.txt of each release (updpkgsums).
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
sha256sums_armv7h=('SKIP')

package() {
	install -Dm755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	install -Dm644 data/LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/DATA-LICENSE.md"
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
